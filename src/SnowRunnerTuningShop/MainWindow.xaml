<Window x:Class="SnowRunnerTuningShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SnowRunnerTuningShop.Views"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        mc:Ignorable="d"
        Title="SnowRunner Tuning Shop"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Height="815"
        Width="1358"
        MinHeight="680"
        MinWidth="900">
    <Grid>
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,10"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MenuButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            ToolTip="{x:Static loc:UiText+Nav.OpenMenu}"
                            Click="MenuButton_Click">
                        <TextBlock Text="☰"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="SnowRunner Tuning Shop"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <views:HomeView x:Name="HomeView"/>
                <views:GeneralView x:Name="GeneralView" Visibility="Collapsed"/>
                <views:PartsView x:Name="PartsView" Visibility="Collapsed"/>
                <views:VehiclesView x:Name="VehiclesView" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border x:Name="NavScrim"
                Background="#66000000"
                Visibility="Collapsed"
                MouseLeftButtonDown="NavScrim_MouseLeftButtonDown"/>

        <Border x:Name="NavPane"
                Width="220"
                HorizontalAlignment="Left"
                Visibility="Collapsed"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="12"
                Opacity="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,20">
                    <TextBlock Text="SnowRunner"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Tuning Shop"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Static loc:UiText+Main.Subtitle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,16,4,4">
                    <CheckBox x:Name="PinMenuCheckBox"
                              Content="{x:Static loc:UiText+Nav.PinMenu}"
                              Margin="0,0,0,10"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Checked="PinMenuCheckBox_Changed"
                              Unchecked="PinMenuCheckBox_Changed"/>
                    <TextBlock Text="{x:Static loc:UiText+Nav.VersionLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Home}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavGeneral"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.General}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavParts"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Parts}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavVehicles"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Vehicles}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Settings}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
