<Window x:Class="SnowRunnerTuningShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SnowRunnerTuningShop.Views"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        mc:Ignorable="d"
        Title="SnowRunner Tuning Shop"
        Height="760"
        Width="1120"
        MinHeight="640"
        MinWidth="960"
        Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SnowRunner Tuning Shop"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>
            <TextBlock Text="{x:Static loc:UiText+Main.Subtitle}"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PakPathTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Padding="10,8"
                         Background="#F9FAFB"
                         BorderBrush="#D1D5DB"
                         Text="{x:Static loc:UiText+Main.NoPakSelected}"/>

                <Button Grid.Column="1"
                        Content="{x:Static loc:UiText+Main.Browse}"
                        Margin="12,0,0,0"
                        Padding="16,8"
                        Click="BrowseButton_Click"/>

                <Button Grid.Column="2"
                        Content="{x:Static loc:UiText+Main.Load}"
                        Margin="12,0,0,0"
                        Padding="16,8"
                        Click="LoadButton_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="{x:Static loc:UiText+Main.TabOverview}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:UiText+Main.OverviewTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock x:Name="OverviewTextBlock"
                                       Text="{x:Static loc:UiText+Main.OverviewPlaceholder}"
                                       TextWrapping="Wrap"
                                       Foreground="#374151"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="8,0,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{x:Static loc:UiText+Main.CategoriesTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <ListView x:Name="CategoriesListView"
                                      BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{x:Static loc:UiText+Main.CategoryColumn}" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="{x:Static loc:UiText+Main.FilesColumn}" Width="70" DisplayMemberBinding="{Binding FileCount}"/>
                                        <GridViewColumn Header="{x:Static loc:UiText+Main.SampleFileColumn}" Width="420" DisplayMemberBinding="{Binding SampleFile}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static loc:UiText+Main.TabWinch}">
                <Border Background="White"
                        CornerRadius="10"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,12,0,0">
                    <views:WinchTuningView x:Name="WinchTuningView"/>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Background="#111827"
                CornerRadius="8"
                Padding="12,10">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#F9FAFB"
                       Text="{x:Static loc:UiText+Main.ReadyStatus}"/>
        </Border>
    </Grid>
</Window>
