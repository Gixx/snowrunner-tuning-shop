<Window x:Class="SnowRunnerTuningShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SnowRunnerTuningShop.Views"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        mc:Ignorable="d"
        Title="SnowRunner Tuning Shop"
        Height="780"
        Width="1200"
        MinHeight="640"
        MinWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,20">
                    <TextBlock Text="SnowRunner"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Tuning Shop"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Static loc:UiText+Main.Subtitle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Home}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavParts"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Parts}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavVehicles"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Vehicles}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings"
                                 GroupName="MainNav"
                                 Content="{x:Static loc:UiText+Nav.Settings}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <views:HomeView x:Name="HomeView"/>
                <views:PartsView x:Name="PartsView" Visibility="Collapsed"/>
                <views:VehiclesView x:Name="VehiclesView" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="12,10">
                <TextBlock x:Name="StatusTextBlock"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{x:Static loc:UiText+Main.ReadyStatus}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
