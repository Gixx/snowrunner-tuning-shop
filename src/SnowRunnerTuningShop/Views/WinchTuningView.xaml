<UserControl x:Class="SnowRunnerTuningShop.Views.WinchTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static loc:UiText+Winch.BaselineTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="BaselineStatusTextBlock"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static loc:UiText+Winch.SetBaselineFromFile}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="SetBaselineFromFileButton_Click"/>
                    <Button x:Name="ImportPythonBaselineButton"
                            Content="{x:Static loc:UiText+Winch.ImportPythonBaseline}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="ImportPythonBaselineButton_Click"/>
                    <Button Content="{x:Static loc:UiText+Winch.ClearBaseline}"
                            Padding="14,8"
                            Click="ClearBaselineButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RestoreWinchesButton"
                            Content="{x:Static loc:UiText+Winch.RestoreWinchesToBaseline}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="RestoreWinchesButton_Click"/>
                    <Button x:Name="RestorePakButton"
                            Content="{x:Static loc:UiText+Winch.RestorePakToBaseline}"
                            Padding="14,8"
                            Click="RestorePakButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="3"
                           Text="{x:Static loc:UiText+Winch.GlobalMultipliersTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="LengthMultiplierLabel"
                               Text="{x:Static loc:UiText+Winch.LengthMultiplierDefault}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Slider x:Name="LengthMultiplierSlider"
                            Minimum="0"
                            Maximum="8"
                            Value="4"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="LengthMultiplierSlider_ValueChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock x:Name="StrengthMultiplierLabel"
                               Text="{x:Static loc:UiText+Winch.StrengthMultiplierDefault}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Slider x:Name="StrengthMultiplierSlider"
                            Minimum="0"
                            Maximum="8"
                            Value="4"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="StrengthMultiplierSlider_ValueChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox x:Name="AutonomousAllCheckBox"
                              Content="{x:Static loc:UiText+Winch.AutonomousAll}"
                              Margin="0,0,0,8"/>
                    <Button Content="{x:Static loc:UiText+Winch.ApplyMultipliers}"
                            Padding="14,8"
                            Click="ApplyMultipliersButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <Button Content="{x:Static loc:UiText+Winch.SaveIndividualChanges}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="SaveIndividualButton_Click"/>
                    <Button Content="{x:Static loc:UiText+Winch.RefreshList}"
                            Padding="14,8"
                            Click="ReloadButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="WinchesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static loc:UiText+Winch.CategoryColumn}" Binding="{Binding Category}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static loc:UiText+Winch.NameColumn}" Binding="{Binding DisplayName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static loc:UiText+Winch.LengthColumn}" Binding="{Binding Length, StringFormat=0.##}" Width="90"/>
                <DataGridTextColumn Header="{x:Static loc:UiText+Winch.StrengthColumn}" Binding="{Binding StrengthMult, StringFormat=0.##}" Width="80"/>
                <DataGridCheckBoxColumn Header="{x:Static loc:UiText+Winch.AutonomousColumn}" Binding="{Binding IsAutonomous}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="WinchInfoTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static loc:UiText+Winch.NoData}"/>
    </Grid>
</UserControl>
