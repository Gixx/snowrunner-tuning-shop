<UserControl x:Class="SnowRunnerTuningShop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- First-time setup -->
        <Border x:Name="SetupPanel"
                Grid.Row="0"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{x:Static loc:UiText+Main.BaselineTitle}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{x:Static loc:UiText+Main.BaselineWarning}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,12"/>
                <Button Content="{x:Static loc:UiText+Main.SetBaselineFromOriginal}"
                        HorizontalAlignment="Left"
                        Padding="14,8"
                        Click="SetBaselineButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Ready state -->
        <Border x:Name="ReadyPanel"
                Grid.Row="0"
                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{x:Static loc:UiText+Main.BaselineReadyTitle}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="BaselineReadyTextBlock"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="WorkingPakTextBlock"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static loc:UiText+Main.ChangeLocation}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="ChangeLocationButton_Click"/>
                    <Button x:Name="RestoreFullBaselineButton"
                            Content="{x:Static loc:UiText+Main.RestoreFullBaseline}"
                            Padding="14,8"
                            Background="#C42B1C"
                            Foreground="White"
                            BorderBrush="#C42B1C"
                            Click="RestoreFullBaselineButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static loc:UiText+Main.OverviewTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="OverviewTextBlock"
                               Text="{x:Static loc:UiText+Main.OverviewPlaceholder}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               LineHeight="22"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static loc:UiText+Main.CategoriesTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <ListView x:Name="CategoriesListView"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.CategoryColumn}" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.ItemsColumn}" Width="70" DisplayMemberBinding="{Binding ItemCount}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.FilesColumn}" Width="70" DisplayMemberBinding="{Binding FileCount}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.SampleFileColumn}" Width="320" DisplayMemberBinding="{Binding SampleFile}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
