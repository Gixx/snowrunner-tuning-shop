<UserControl x:Class="SnowRunnerTuningShop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- First-time setup -->
            <Border x:Name="SetupPanel"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Main.BaselineTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+Main.BaselineWarning}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Button Content="{x:Static loc:UiText+Main.SetBaselineFromOriginal}"
                            HorizontalAlignment="Left"
                            Padding="14,8"
                            Click="SetBaselineButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="UpdateBanner"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Settings.UpdateAvailableTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="UpdateBannerMessage"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="{x:Static loc:UiText+Settings.DownloadUpdate}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="DownloadUpdateButton_Click"/>
                        <Button Content="{x:Static loc:UiText+Settings.SkipThisVersion}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="SkipUpdateButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="HealthBanner"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="HealthBannerTitle"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="HealthBannerMessage"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Ready state -->
            <Border x:Name="ReadyPanel"
                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Main.BaselineReadyTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="BaselineReadyTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="WorkingPakTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ProfileStatusTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="{x:Static loc:UiText+Main.ChangeLocation}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="ChangeLocationButton_Click"/>
                        <Button x:Name="RefreshBaselineButton"
                                Content="{x:Static loc:UiText+Workspace.RefreshBaseline}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                ToolTipService.ShowOnDisabled="True"
                                Click="RefreshBaselineButton_Click"/>
                        <Button x:Name="ReapplyButton"
                                Content="{x:Static loc:UiText+Workspace.ReapplySavedChanges}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="ReapplyButton_Click"/>
                        <Button x:Name="RestoreFullBaselineButton"
                                Content="{x:Static loc:UiText+Main.RestoreFullBaseline}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Background="#C42B1C"
                                Foreground="White"
                                BorderBrush="#C42B1C"
                                Click="RestoreFullBaselineButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static loc:UiText+Main.PresetsTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="PresetNewButton"
                                Content="{x:Static loc:UiText+Main.PresetNew}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="PresetNewButton_Click"/>
                        <Button x:Name="PresetExportButton"
                                Content="{x:Static loc:UiText+Main.PresetExport}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="PresetExportButton_Click"/>
                        <Button x:Name="PresetImportButton"
                                Content="{x:Static loc:UiText+Main.PresetImport}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="PresetImportButton_Click"/>
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button x:Name="PresetApplyButton"
                                Content="{x:Static loc:UiText+Main.PresetApply}"
                                Padding="14,8"
                                Margin="0,0,8,0"
                                Click="PresetApplyButton_Click"/>
                        <Button x:Name="PresetSaveAsNewButton"
                                Content="{x:Static loc:UiText+Main.PresetSaveAsNew}"
                                Padding="14,8"
                                Margin="0,0,8,0"
                                Click="PresetSaveAsNewButton_Click"/>
                        <Button x:Name="PresetDeleteButton"
                                Content="{x:Static loc:UiText+Main.PresetDelete}"
                                Padding="14,8"
                                Click="PresetDeleteButton_Click"/>
                    </WrapPanel>
                    <ListView x:Name="PresetsListView"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionMode="Single"
                              PreviewMouseLeftButtonDown="PresetsListView_PreviewMouseLeftButtonDown"
                              SelectionChanged="PresetsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.PresetNameColumn}"
                                                Width="140"
                                                DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.PresetVersionColumn}"
                                                Width="60"
                                                DisplayMemberBinding="{Binding Version}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.PresetAuthorColumn}"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Author}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.PresetLockColumn}"
                                                Width="40"
                                                DisplayMemberBinding="{Binding LockGlyph}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.PresetStatusColumn}"
                                                Width="110"
                                                DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0,0,0">
                <Grid>
                    <DockPanel x:Name="CategoriesPanel" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{x:Static loc:UiText+Main.CategoriesTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <ListView x:Name="CategoriesListView"
                                  BorderThickness="0"
                                  Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{x:Static loc:UiText+Main.CategoryColumn}" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="{x:Static loc:UiText+Main.ItemsColumn}" Width="70" DisplayMemberBinding="{Binding ItemCount}"/>
                                    <GridViewColumn Header="{x:Static loc:UiText+Main.FilesColumn}" Width="70" DisplayMemberBinding="{Binding FileCount}"/>
                                    <GridViewColumn Header="{x:Static loc:UiText+Main.SampleFileColumn}" Width="280" DisplayMemberBinding="{Binding SampleFile}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <DockPanel x:Name="PresetDetailPanel"
                               LastChildFill="True"
                               Visibility="Collapsed">
                        <TextBlock x:Name="PresetDetailTitleText"
                                   DockPanel.Dock="Top"
                                   Text="{x:Static loc:UiText+Main.PresetDetailTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <TextBlock x:Name="PresetDetailNameText"
                                   DockPanel.Dock="Top"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="PresetDetailAuthorText"
                                   DockPanel.Dock="Top"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="PresetDetailVersionText"
                                   DockPanel.Dock="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PresetDetailDescriptionText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       LineHeight="20"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
