<UserControl x:Class="SnowRunnerTuningShop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static loc:UiText+Main.BaselineFileTitle}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PakPathTextBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Padding="10,8"
                             Text="{x:Static loc:UiText+Main.NoPakSelected}"/>
                    <Button Grid.Column="1"
                            Content="{x:Static loc:UiText+Main.Browse}"
                            Margin="12,0,0,0"
                            Padding="16,8"
                            Click="BrowseButton_Click"/>
                    <Button Grid.Column="2"
                            Content="{x:Static loc:UiText+Main.Load}"
                            Margin="12,0,0,0"
                            Padding="16,8"
                            Click="LoadButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static loc:UiText+Main.OverviewTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="OverviewTextBlock"
                               Text="{x:Static loc:UiText+Main.OverviewPlaceholder}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               LineHeight="22"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static loc:UiText+Main.CategoriesTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <ListView x:Name="CategoriesListView"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.CategoryColumn}" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.FilesColumn}" Width="70" DisplayMemberBinding="{Binding FileCount}"/>
                                <GridViewColumn Header="{x:Static loc:UiText+Main.SampleFileColumn}" Width="360" DisplayMemberBinding="{Binding SampleFile}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
