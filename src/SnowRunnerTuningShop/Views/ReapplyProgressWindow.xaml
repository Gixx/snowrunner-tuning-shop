<Window x:Class="SnowRunnerTuningShop.Views.ReapplyProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        Title="{x:Static loc:UiText+Workspace.ReapplyProgressTitle}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusTitleText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="{x:Static loc:UiText+Workspace.ReapplyProgressTitle}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="StatusDetailText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,14"/>

        <ProgressBar x:Name="ReapplyProgressBar"
                     Grid.Row="2"
                     Height="16"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="True"
                     Margin="0,0,0,8"/>

        <TextBlock x:Name="CounterText"
                   Grid.Row="3"
                   HorizontalAlignment="Right"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Window>
