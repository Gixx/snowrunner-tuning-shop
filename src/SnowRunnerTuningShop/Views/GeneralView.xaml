<UserControl x:Class="SnowRunnerTuningShop.Views.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="900">
    <Grid>
        <StackPanel>
            <TextBlock Text="{x:Static loc:UiText+General.Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+General.CameraTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+General.CameraHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:UiText+General.CameraModeLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="CameraModeCombo"
                                  Grid.Column="1"
                                  MaxWidth="320"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static loc:UiText+General.ApplyCamera}"
                                Padding="14,8"
                                Margin="0,0,8,0"
                                Click="ApplyCameraButton_Click"/>
                        <Button x:Name="RestoreCameraButton"
                                Content="{x:Static loc:UiText+General.RestoreCameraBaseline}"
                                Padding="14,8"
                                Click="RestoreCameraButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+General.RockTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+General.RockHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="RockSizeLabel"
                               Text="{x:Static loc:UiText+General.RockSizeDefault}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <Slider x:Name="RockSizeSlider"
                            Minimum="0"
                            Maximum="4"
                            Value="4"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="RockSizeSlider_ValueChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{x:Static loc:UiText+General.ApplyRockSize}"
                                Padding="14,8"
                                Margin="0,0,8,0"
                                Click="ApplyRockSizeButton_Click"/>
                        <Button x:Name="RestoreRockSizeButton"
                                Content="{x:Static loc:UiText+General.RestoreRockBaseline}"
                                Padding="14,8"
                                Click="RestoreRockSizeButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="HintText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
