<UserControl x:Class="SnowRunnerTuningShop.Views.PartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SnowRunnerTuningShop.Views"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <TabControl BorderThickness="0" Background="Transparent">
        <TabItem Header="{x:Static loc:UiText+Parts.Winch}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <views:WinchTuningView x:Name="WinchTuningView"/>
            </Border>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Engine}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <views:EngineTuningView x:Name="EngineTuningView"/>
            </Border>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Gearbox}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <views:GearboxTuningView x:Name="GearboxTuningView"/>
            </Border>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Suspension}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <views:SuspensionTuningView x:Name="SuspensionTuningView"/>
            </Border>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Tires}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <views:TireTuningView x:Name="TireTuningView"/>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
