<UserControl x:Class="SnowRunnerTuningShop.Views.PartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SnowRunnerTuningShop.Views"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <TabControl BorderThickness="0" Background="Transparent">
        <TabItem Header="{x:Static loc:UiText+Parts.Winch}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <views:WinchTuningView x:Name="WinchTuningView"/>
            </Border>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Engine}">
            <TextBlock Text="{x:Static loc:UiText+Parts.ComingSoon}"
                       Margin="0,24,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Gearbox}">
            <TextBlock Text="{x:Static loc:UiText+Parts.ComingSoon}"
                       Margin="0,24,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </TabItem>
        <TabItem Header="{x:Static loc:UiText+Parts.Suspension}">
            <TextBlock Text="{x:Static loc:UiText+Parts.ComingSoon}"
                       Margin="0,24,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </TabItem>
    </TabControl>
</UserControl>
