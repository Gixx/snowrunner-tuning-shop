<Window x:Class="SnowRunnerTuningShop.Views.LocaleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        Title="{x:Static loc:UiText+LocalePack.Title}"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{x:Static loc:UiText+LocalePack.Title}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="{x:Static loc:UiText+LocalePack.Hint}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="RefreshButton"
                    Content="{x:Static loc:UiText+LocalePack.Refresh}"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Click="RefreshButton_Click"/>
            <Button x:Name="ApplyButton"
                    Content="{x:Static loc:UiText+LocalePack.Apply}"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="ApplyButton_Click"/>
            <Button Content="{x:Static loc:UiText+LocalePack.Close}"
                    Padding="14,8"
                    IsCancel="True"/>
        </StackPanel>
        <Border x:Name="PackListHost"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      Margin="12,8"
                      TextBlock.FontWeight="SemiBold"
                      TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:UiText+LocalePack.ColumnAddUpdate}"/>
                    <TextBlock Grid.Column="1" Text="{x:Static loc:UiText+LocalePack.ColumnRemove}"/>
                    <TextBlock Grid.Column="2" Text="{x:Static loc:UiText+LocalePack.ColumnLanguage}"/>
                    <TextBlock Grid.Column="3" Text="{x:Static loc:UiText+LocalePack.ColumnStatus}"/>
                    <TextBlock Grid.Column="4" Text="{x:Static loc:UiText+LocalePack.ColumnRevision}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PackList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="88"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding Wanted, Mode=TwoWay}"
                                              IsEnabled="{Binding CanAddOrUpdate}"/>
                                    <CheckBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding RemoveSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanRemove}"/>
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Column="3"
                                               VerticalAlignment="Center"
                                               Text="{Binding Status}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="4"
                                               VerticalAlignment="Center"
                                               Text="{Binding RevisionText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
