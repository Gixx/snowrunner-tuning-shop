<UserControl x:Class="SnowRunnerTuningShop.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <Grid>
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="FilterAll"
                             Content="{x:Static loc:UiText+Vehicles.All}"
                             Margin="0,0,8,0"
                             Checked="Filter_Checked"/>
                <RadioButton Content="{x:Static loc:UiText+Vehicles.Highway}"
                             Tag="Highway"
                             Margin="0,0,8,0"
                             Checked="Filter_Checked"/>
                <RadioButton Content="{x:Static loc:UiText+Vehicles.HeavyDuty}"
                             Tag="Heavy Duty"
                             Margin="0,0,8,0"
                             Checked="Filter_Checked"/>
                <RadioButton Content="{x:Static loc:UiText+Vehicles.Heavy}"
                             Tag="Heavy"
                             Margin="0,0,8,0"
                             Checked="Filter_Checked"/>
                <RadioButton Content="{x:Static loc:UiText+Vehicles.Offroad}"
                             Tag="Offroad"
                             Margin="0,0,8,0"
                             Checked="Filter_Checked"/>
                <RadioButton Content="{x:Static loc:UiText+Vehicles.Scout}"
                             Tag="Scout"
                             Margin="0,0,8,0"
                             Checked="Filter_Checked"/>
            </StackPanel>

            <TextBlock x:Name="CountTextBlock"
                       Grid.Row="1"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="VehiclesItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="168"
                                    Margin="0,0,12,12"
                                    Padding="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="VehicleCard_Click">
                                <StackPanel>
                                    <Image Source="{Binding Image}"
                                           Height="200"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="{x:Static loc:UiText+Vehicles.BackToList}"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                    Margin="0,0,0,12"
                    Click="BackButton_Click"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="DetailTitleText"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Image x:Name="DetailImage"
                               MaxHeight="420"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="DetailCategoryText"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock Text="{x:Static loc:UiText+Vehicles.DetailPlaceholder}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
