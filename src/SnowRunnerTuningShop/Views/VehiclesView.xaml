<UserControl x:Class="SnowRunnerTuningShop.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization">
    <UserControl.Resources>
        <Style x:Key="FilterChipRadioStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse Stroke="{TemplateBinding Foreground}"
                                             StrokeThickness="1.5"
                                             Fill="Transparent"/>
                                    <Ellipse x:Name="Dot"
                                             Width="8"
                                             Height="8"
                                             Fill="{TemplateBinding Foreground}"
                                             Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="4"
                               Text="{x:Static loc:UiText+Vehicles.GlobalMultipliersTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="4"
                               Text="{x:Static loc:UiText+Vehicles.GlobalMultipliersHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="FuelMultiplierLabel"
                                   Text="{x:Static loc:UiText+Vehicles.FuelMultiplierDefault}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Slider x:Name="FuelMultiplierSlider"
                                Minimum="0"
                                Maximum="8"
                                Value="4"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsEnabled="False"
                                ValueChanged="GlobalMultiplierSlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock x:Name="FrontSteerGlobalLabel"
                                   Text="{x:Static loc:UiText+Vehicles.FrontSteerGlobalDefault}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Slider x:Name="FrontSteerGlobalSlider"
                                Minimum="0"
                                Maximum="2"
                                Value="1"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsEnabled="False"
                                ValueChanged="GlobalMultiplierSlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="12,0,12,0">
                        <TextBlock x:Name="ResponsivenessMultiplierLabel"
                                   Text="{x:Static loc:UiText+Vehicles.ResponsivenessMultiplierDefault}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Slider x:Name="ResponsivenessMultiplierSlider"
                                Minimum="0"
                                Maximum="8"
                                Value="4"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsEnabled="False"
                                ValueChanged="GlobalMultiplierSlider_ValueChanged"/>
                    </StackPanel>

                    <Button x:Name="ApplyGlobalMultipliersButton"
                            Grid.Row="2"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Content="{x:Static loc:UiText+Vehicles.ApplyGlobalMultipliers}"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Click="ApplyGlobalMultipliersButton_Click"/>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,12,0">
                        <TextBlock x:Name="PriceMultiplierLabel"
                                   Text="{x:Static loc:UiText+Vehicles.PriceMultiplierDefault}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Slider x:Name="PriceMultiplierSlider"
                                Minimum="0"
                                Maximum="8"
                                Value="4"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsEnabled="False"
                                ValueChanged="GlobalMultiplierSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260" MinWidth="160"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAll"
                                 Style="{StaticResource FilterChipRadioStyle}"
                                 Content="{x:Static loc:UiText+Vehicles.All}"
                                 Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                 Content="{x:Static loc:UiText+Vehicles.Highway}"
                                 Tag="Highway"
                                 Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                 Content="{x:Static loc:UiText+Vehicles.HeavyDuty}"
                                 Tag="Heavy Duty"
                                 Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                 Content="{x:Static loc:UiText+Vehicles.Heavy}"
                                 Tag="Heavy"
                                 Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                 Content="{x:Static loc:UiText+Vehicles.Offroad}"
                                 Tag="Offroad"
                                 Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource FilterChipRadioStyle}"
                                 Content="{x:Static loc:UiText+Vehicles.Scout}"
                                 Tag="Scout"
                                 Checked="Filter_Checked"/>
                </WrapPanel>

                <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox"
                             Padding="10,7"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="{x:Static loc:UiText+Vehicles.SearchPlaceholder}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <TextBlock x:Name="CountTextBlock"
                       Grid.Row="2"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="VehiclesItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="168"
                                    Margin="0,0,12,12"
                                    Padding="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="VehicleCard_Click">
                                <StackPanel>
                                    <Grid Height="200">
                                        <Image Source="{Binding Image}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border VerticalAlignment="Top"
                                                Height="24"
                                                Background="{Binding HeaderBrush}"
                                                IsHitTestVisible="False">
                                            <Grid Margin="5,0">
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="White"
                                                        CornerRadius="9"
                                                        Padding="7,1"
                                                        Visibility="{Binding OvalVisibility}">
                                                    <TextBlock Text="{Binding OvalCode}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#FF111111"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#33000000"
                                                        BorderThickness="1"
                                                        Visibility="{Binding FlagVisibility}">
                                                    <Image Source="{Binding Flag}"
                                                           Width="28"
                                                           Height="16"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="{x:Static loc:UiText+Vehicles.BackToList}"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                    Margin="0,0,0,12"
                    Click="BackButton_Click"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <!-- Dark plate so white wiki logos stay visible on light theme -->
                        <Border x:Name="ManufacturerLogoPlate"
                                Background="#FF1E1E1E"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Visibility="Collapsed">
                            <Image x:Name="DetailManufacturerLogo"
                                   MaxHeight="28"
                                   MaxWidth="110"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="DetailTitleText"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Image x:Name="DetailImage"
                               MaxHeight="360"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <Border x:Name="DetailMetaPanel"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <StackPanel x:Name="BasedOnRow" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.BasedOnLabel}"
                                           Width="100"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailBasedOnText"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="RoleRow" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.RoleLabel}"
                                           Width="100"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailRoleText"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="YearsRow" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.YearsLabel}"
                                           Width="100"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailYearsText"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="CountryRow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static loc:UiText+Vehicles.CountryLabel}"
                                               Width="100"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Image x:Name="DetailCountryFlag"
                                           Width="28"
                                           Height="18"
                                           Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="DetailCountryName"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.CountryHint}"
                                           Margin="100,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <TextBlock x:Name="TuningHintText"
                                   Text="{x:Static loc:UiText+Vehicles.LoadPakHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <StackPanel x:Name="TuningForm"
                                    Visibility="Collapsed">
                            <TextBlock Text="{x:Static loc:UiText+Vehicles.TuningTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Margin="0,0,0,16"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.FuelTankLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FuelCapacityTextBox"
                                             Padding="10,7"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TuningNumericTextBox_TextChanged"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static loc:UiText+Vehicles.FuelUnit}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="FuelSafeRangeHint"
                                       Margin="140,0,0,14"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.StorePriceLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox x:Name="StorePriceTextBox"
                                         Grid.Column="1"
                                         MaxWidth="140"
                                         HorizontalAlignment="Left"
                                         Padding="10,7"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TuningNumericTextBox_TextChanged"/>
                            </Grid>
                            <TextBlock x:Name="PriceSafeRangeHint"
                                       Margin="140,0,0,14"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid x:Name="FrontSteerRow" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.FrontSteerLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FrontSteerTextBox"
                                             Padding="10,7"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TuningNumericTextBox_TextChanged"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static loc:UiText+Vehicles.SteerAngleUnit}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="FrontSteerHintText"
                                       Margin="140,0,0,4"
                                       Text="{x:Static loc:UiText+Vehicles.FrontSteerHint}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="FrontSteerSafeRangeHint"
                                       Margin="140,0,0,14"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid x:Name="RearSteerRow" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.RearSteerLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RearSteerTextBox"
                                             Padding="10,7"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TuningNumericTextBox_TextChanged"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static loc:UiText+Vehicles.SteerAngleUnit}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="RearSteerHintText"
                                       Margin="140,0,0,4"
                                       Text="{x:Static loc:UiText+Vehicles.RearSteerHint}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RearSteerSafeRangeHint"
                                       Margin="140,0,0,14"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.ResponsivenessLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox x:Name="ResponsivenessTextBox"
                                         Grid.Column="1"
                                         MaxWidth="140"
                                         HorizontalAlignment="Left"
                                         Padding="10,7"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TuningNumericTextBox_TextChanged"/>
                            </Grid>
                            <TextBlock Text="{x:Static loc:UiText+Vehicles.ResponsivenessHint}"
                                       Margin="140,0,0,4"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ResponsivenessSafeRangeHint"
                                       Margin="140,0,0,14"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.DiffLockLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="DiffLockCombo"
                                          Grid.Column="1"
                                          MaxWidth="280"
                                          HorizontalAlignment="Left"
                                          Padding="8,6"/>
                            </Grid>
                            <TextBlock x:Name="DiffLockHintText"
                                       Margin="140,0,0,14"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:UiText+Vehicles.DriveLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="DriveCombo"
                                          Grid.Column="1"
                                          MaxWidth="280"
                                          HorizontalAlignment="Left"
                                          Padding="8,6"/>
                            </Grid>
                            <TextBlock Text="{x:Static loc:UiText+Vehicles.DriveHint}"
                                       Margin="140,0,0,18"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static loc:UiText+Vehicles.SaveChanges}"
                                        Padding="14,8"
                                        Margin="0,0,8,0"
                                        Click="SaveTuningButton_Click"/>
                                <Button x:Name="RestoreVehicleButton"
                                        Content="{x:Static loc:UiText+Vehicles.RestoreThisVehicle}"
                                        Padding="14,8"
                                        Click="RestoreVehicleButton_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="TuningStatusText"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
