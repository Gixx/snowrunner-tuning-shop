<UserControl x:Class="SnowRunnerTuningShop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="{x:Static loc:UiText+Settings.Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Settings.AppearanceTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+Settings.AppearanceHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:UiText+Settings.ThemeLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="ThemeCombo"
                                  Grid.Column="1"
                                  MaxWidth="320"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"
                                  SelectionChanged="ThemeCombo_SelectionChanged"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Settings.WorkspaceTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+Settings.WorkspaceHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="WorkspaceStatusTextBlock"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="RefreshBaselineButton"
                                Content="{x:Static loc:UiText+Workspace.RefreshBaseline}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="RefreshBaselineButton_Click"/>
                        <Button x:Name="ReapplyButton"
                                Content="{x:Static loc:UiText+Workspace.ReapplySavedChanges}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="ReapplyButton_Click"/>
                        <Button x:Name="RestoreFullBaselineButton"
                                Content="{x:Static loc:UiText+Main.RestoreFullBaseline}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Background="#C42B1C"
                                Foreground="White"
                                BorderBrush="#C42B1C"
                                Click="RestoreFullBaselineButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Settings.AboutTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+Settings.AboutHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static loc:UiText+Settings.InstalledVersion}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="UpdateStatusTextBlock"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="CheckForUpdatesButton"
                                Content="{x:Static loc:UiText+Settings.CheckForUpdates}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="CheckForUpdatesButton_Click"/>
                        <Button x:Name="DownloadUpdateButton"
                                Content="{x:Static loc:UiText+Settings.DownloadUpdate}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="DownloadUpdateButton_Click"/>
                        <Button Content="{x:Static loc:UiText+Settings.OpenWebsite}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="OpenWebsiteButton_Click"/>
                        <Button Style="{StaticResource PayPalDonateButtonStyle}"
                                Margin="0,0,8,8"
                                ToolTip="{x:Static loc:UiText+Settings.DonatePayPal}"
                                AutomationProperties.Name="{x:Static loc:UiText+Settings.DonatePayPal}"
                                Click="DonatePayPalButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static loc:UiText+Settings.DonateWith}"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           Foreground="#111111"
                                           VerticalAlignment="Center"
                                           Margin="0,1,7,0"/>
                                <TextBlock FontFamily="Arial"
                                           FontStyle="Italic"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           VerticalAlignment="Center">
                                    <Run Text="Pay" Foreground="#003087"/>
                                    <Run Text="Pal" Foreground="#009CDE"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+Settings.FeedbackTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static loc:UiText+Settings.FeedbackHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <Button Content="{x:Static loc:UiText+Settings.OpenIssueTracker}"
                            HorizontalAlignment="Left"
                            Padding="14,8"
                            Click="OpenIssueTrackerButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
