<Window x:Class="SnowRunnerTuningShop.Views.SavePresetAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        Title="{x:Static loc:UiText+Main.PresetSaveAsTitle}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:UiText+Main.PresetSaveAsNameLabel}"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Padding="8"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="{x:Static loc:UiText+Main.PresetSaveAsVersionLabel}"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="VersionBox"
                 Grid.Row="3"
                 Text="1.0.0"
                 Padding="8"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4"
                   Text="{x:Static loc:UiText+Main.PresetSaveAsAuthorLabel}"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="AuthorBox"
                 Grid.Row="5"
                 Padding="8"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="6"
                   Text="{x:Static loc:UiText+Main.PresetSaveAsDescriptionLabel}"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="DescriptionBox"
                 Grid.Row="7"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="96"
                 MaxHeight="180"
                 Padding="8"
                 Margin="0,0,0,12"/>

        <CheckBox x:Name="LockedCheckBox"
                  Grid.Row="8"
                  Content="{x:Static loc:UiText+Main.PresetSaveAsLockedLabel}"
                  Margin="0,0,0,16"
                  ToolTip="{x:Static loc:UiText+Main.PresetSaveAsLockedHint}"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:UiText+Main.PresetSaveAsCancel}"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button Content="{x:Static loc:UiText+Main.PresetSaveAsSave}"
                    Padding="14,8"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
