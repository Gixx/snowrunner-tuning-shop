<Window x:Class="SnowRunnerTuningShop.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        Title="{x:Static loc:UiText+BugReport.Title}"
        Width="560"
        Height="480"
        MinWidth="460"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{x:Static loc:UiText+BugReport.Heading}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{x:Static loc:UiText+BugReport.DescriptionLabel}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,6"/>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="DescriptionBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MaxLength="600"
                     FontSize="13"
                     Padding="8"
                     TextChanged="DescriptionBox_TextChanged"/>
            <TextBlock x:Name="CharCountText"
                       Grid.Row="1"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <CheckBox x:Name="IncludeProfileCheckBox"
                  Grid.Row="3"
                  Content="{x:Static loc:UiText+BugReport.IncludeProfile}"
                  Margin="0,8,0,6"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <TextBlock Grid.Row="4"
                   Text="{x:Static loc:UiText+BugReport.ProfilePrivacyNote}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5"
                   Text="{x:Static loc:UiText+BugReport.SubmitHint}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16"/>

        <DockPanel Grid.Row="6" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Content="{x:Static loc:UiText+BugReport.Cancel}"
                    Padding="14,8"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="SendButton"
                    DockPanel.Dock="Right"
                    Content="{x:Static loc:UiText+BugReport.Send}"
                    Padding="14,8"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="SendButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
