<UserControl x:Class="SnowRunnerTuningShop.Views.PhotoModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="{x:Static loc:UiText+PhotoMode.Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static loc:UiText+PhotoMode.Subtitle}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+PhotoMode.EnvironmentTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:UiText+PhotoMode.TimeLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="TimeCombo"
                                  Grid.Column="1"
                                  MaxWidth="320"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:UiText+PhotoMode.WeatherLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="WeatherCombo"
                                  Grid.Column="1"
                                  MaxWidth="320"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+PhotoMode.LookTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Grid x:Name="LookPanel"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText+PhotoMode.CameraTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Grid x:Name="CameraPanel"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{x:Static loc:UiText+PhotoMode.Apply}"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Click="ApplyButton_Click"/>
                <Button x:Name="RestoreButton"
                        Content="{x:Static loc:UiText+PhotoMode.RestoreBaseline}"
                        Padding="14,8"
                        Click="RestoreButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="HintText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
