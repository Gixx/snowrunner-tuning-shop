<Window x:Class="SnowRunnerTuningShop.Views.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SnowRunnerTuningShop.Localization"
        Title="{x:Static loc:UiText+CrashReport.Title}"
        Width="640"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{x:Static loc:UiText+CrashReport.Heading}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12"/>

        <TextBox x:Name="ReportTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Margin="0,0,0,12"/>

        <TextBlock x:Name="LogPathText"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Content="{x:Static loc:UiText+CrashReport.CopyReport}"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Click="CopyButton_Click"/>
            <Button x:Name="GitHubButton"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Click="GitHubButton_Click"/>
            <Button x:Name="EmailButton"
                    Content="{x:Static loc:UiText+CrashReport.EmailReport}"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="EmailButton_Click"/>
            <Button x:Name="CloseButton"
                    Content="{x:Static loc:UiText+CrashReport.Continue}"
                    Padding="14,8"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
