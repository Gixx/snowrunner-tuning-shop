<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>SnowRunnerTuningShop.Desktop</RootNamespace>
    <AssemblyName>SnowRunnerTuningShop.Desktop</AssemblyName>
    <Product>SnowRunner Tuning Shop</Product>
    <Description>Cross-platform Avalonia UI (Linux Flatpak target; Windows sidecar next to WPF).</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnowRunnerTuningShop.Core\SnowRunnerTuningShop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SnowRunnerTuningShop\AppSession.cs" Link="Shared\AppSession.cs" />
    <Compile Include="..\SnowRunnerTuningShop\AppPaths.cs" Link="Shared\AppPaths.cs" />
    <Compile Include="..\SnowRunnerTuningShop\LanguageService.cs" Link="Shared\LanguageService.cs" />
    <Compile Include="..\SnowRunnerTuningShop\Diagnostics\DebugCrashTools.cs" Link="Shared\DebugCrashTools.cs" />
    <Compile Include="..\SnowRunnerTuningShop\Localization\*.cs" Link="Localization\%(Filename).cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\vehicles\**\*" Exclude="..\..\assets\vehicles\_meta_build\**\*">
      <Link>assets\vehicles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\trailers\**\*" Exclude="..\..\assets\trailers\_meta_build\**\*">
      <Link>assets\trailers\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\general\**\*">
      <Link>assets\general\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\localization\*.json" Exclude="..\..\assets\localization\hu.json;..\..\assets\localization\it.json;..\..\assets\localization\fi.json">
      <Link>assets\localization\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
