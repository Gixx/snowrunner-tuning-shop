<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SnowRunnerTuningShop.Desktop.Views.ReapplyProgressWindow"
        Title="Reapplying saved changes"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock x:Name="StatusTitleText"
               FontSize="16"
               FontWeight="SemiBold"/>
    <TextBlock x:Name="StatusDetailText" TextWrapping="Wrap" Opacity="0.85"/>
    <ProgressBar x:Name="ReapplyProgressBar"
                 Height="16"
                 Minimum="0"
                 Maximum="100"
                 IsIndeterminate="True"/>
    <TextBlock x:Name="CounterText"
               HorizontalAlignment="Right"
               FontSize="11"
               Opacity="0.7"/>
  </StackPanel>
</Window>
