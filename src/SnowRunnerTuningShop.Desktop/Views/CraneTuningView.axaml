<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnowRunnerTuningShop.Desktop.Views.CraneTuningView">
  <Grid RowDefinitions="Auto,Auto,*">
    <Expander x:Name="MultipliersExpander"
              Grid.Row="0"
              IsExpanded="True"
              Margin="0,0,0,12"
              HorizontalAlignment="Stretch"
              Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <Grid ColumnDefinitions="*,*,Auto" HorizontalAlignment="Stretch">
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock x:Name="ArmForceMultiplierLabel"/>
          <Slider x:Name="ArmForceMultiplierSlider"
                  Minimum="0" Maximum="13" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,12,0">
          <TextBlock x:Name="MovementSpeedMultiplierLabel"/>
          <Slider x:Name="MovementSpeedMultiplierSlider"
                  Minimum="0" Maximum="8" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Button x:Name="ApplyMultipliersButton" Padding="14,8" Click="ApplyMultipliersButton_Click"/>
        </StackPanel>
      </Grid>
    </Expander>

    <Border Grid.Row="1"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,280">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="SaveIndividualButton" Padding="14,8" Click="SaveIndividualButton_Click"/>
          <Button x:Name="RestoreCranesButton" Padding="14,8" Click="RestoreCranesButton_Click"/>
          <Button x:Name="ReloadButton" Padding="14,8" Click="ReloadButton_Click"/>
        </StackPanel>
        <TextBox x:Name="FilterTextBox"
                 Grid.Column="1"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center"
                 TextChanged="FilterTextBox_TextChanged"/>
      </Grid>
    </Border>

    <DataGrid x:Name="CranesGrid"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              CanUserReorderColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding DisplayName}" Width="180" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding Price}" Width="70" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding AverageArmForce}" Width="100"/>
        <DataGridTextColumn Binding="{Binding SpeedOY}" Width="80"/>
        <DataGridTextColumn Binding="{Binding SpeedOYWithLoad}" Width="90"/>
        <DataGridTextColumn Binding="{Binding SpeedXZ}" Width="80"/>
        <DataGridTextColumn Binding="{Binding SpeedXZWithLoad}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
