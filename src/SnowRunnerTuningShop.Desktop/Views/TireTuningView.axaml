<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnowRunnerTuningShop.Desktop.Views.TireTuningView">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Expander x:Name="MultipliersExpander"
              Grid.Row="0"
              IsExpanded="True"
              Margin="0,0,0,12"
              HorizontalAlignment="Stretch"
              Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <Grid ColumnDefinitions="*,*,*,Auto,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
          <TextBlock x:Name="OnRoadFrictionMultiplierLabel"/>
          <Slider x:Name="OnRoadFrictionMultiplierSlider"
                  Minimum="0" Maximum="10" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,12,8">
          <TextBlock x:Name="OffRoadFrictionMultiplierLabel"/>
          <Slider x:Name="OffRoadFrictionMultiplierSlider"
                  Minimum="0" Maximum="10" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,12,8">
          <TextBlock x:Name="MudFrictionMultiplierLabel"/>
          <Slider x:Name="MudFrictionMultiplierSlider"
                  Minimum="0" Maximum="10" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <CheckBox x:Name="GlobalIgnoreIceCheckBox"
                  Grid.Row="0"
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Margin="12,0,16,8"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
          <TextBlock x:Name="DamageMultiplierLabel"/>
          <Slider x:Name="DamageMultiplierSlider"
                  Minimum="0" Maximum="10" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,12,0">
          <TextBlock x:Name="PriceMultiplierLabel"/>
          <Slider x:Name="PriceMultiplierSlider"
                  Minimum="0" Maximum="10" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                  PropertyChanged="MultiplierSlider_PropertyChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center">
          <Button x:Name="ApplyMultipliersButton" Padding="14,8" Click="ApplyMultipliersButton_Click"/>
        </StackPanel>
      </Grid>
    </Expander>

    <Expander x:Name="CategoryFrictionExpander"
              Grid.Row="1"
              IsExpanded="False"
              Margin="0,0,0,12"
              HorizontalAlignment="Stretch"
              Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <StackPanel Spacing="12">
        <TextBlock x:Name="CategoryFrictionHintText" TextWrapping="Wrap" Opacity="0.8"/>
        <WrapPanel>
          <CheckBox x:Name="CategoryHighwayCheckBox" Margin="0,0,16,8"/>
          <CheckBox x:Name="CategoryAllTerrainCheckBox" Margin="0,0,16,8"/>
          <CheckBox x:Name="CategoryOffroadCheckBox" Margin="0,0,16,8"/>
          <CheckBox x:Name="CategoryMudCheckBox" Margin="0,0,16,8"/>
          <CheckBox x:Name="CategoryChainedCheckBox" Margin="0,0,16,8"/>
        </WrapPanel>
        <Grid ColumnDefinitions="*,*,*,Auto">
          <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="4">
            <TextBlock x:Name="CategoryOnRoadLabel"/>
            <ComboBox x:Name="CategoryOnRoadCombo" MinWidth="120"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="4">
            <TextBlock x:Name="CategoryOffRoadLabel"/>
            <ComboBox x:Name="CategoryOffRoadCombo" MinWidth="120"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="12,0,12,0" Spacing="4">
            <TextBlock x:Name="CategoryMudLabel"/>
            <ComboBox x:Name="CategoryMudCombo" MinWidth="120"/>
          </StackPanel>
          <Button x:Name="ApplyCategoryFrictionButton"
                  Grid.Column="3"
                  Padding="14,8"
                  VerticalAlignment="Bottom"
                  Click="ApplyCategoryFrictionButton_Click"/>
        </Grid>
        <TextBlock x:Name="CategoryFrictionScaleNoteText" TextWrapping="Wrap" Opacity="0.8"/>
      </StackPanel>
    </Expander>

    <Border Grid.Row="2"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,280">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="SaveIndividualButton" Padding="14,8" Click="SaveIndividualButton_Click"/>
          <Button x:Name="RestoreTiresButton" Padding="14,8" Click="RestoreTiresButton_Click"/>
          <Button x:Name="ReloadButton" Padding="14,8" Click="ReloadButton_Click"/>
        </StackPanel>
        <TextBox x:Name="FilterTextBox"
                 Grid.Column="1"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center"
                 TextChanged="FilterTextBox_TextChanged"/>
      </Grid>
    </Border>

    <DataGrid x:Name="TiresGrid"
              Grid.Row="3"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              CanUserReorderColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Category}" Width="70" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding DisplayName}" Width="160" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding UsedBy}" Width="200" MinWidth="120" IsReadOnly="True"/>
        <DataGridTextColumn Binding="{Binding Price}" Width="80"/>
        <DataGridTextColumn Binding="{Binding DamageCapacity}" Width="90"/>
        <DataGridTextColumn Binding="{Binding OnRoadFriction}" Width="90"/>
        <DataGridTextColumn Binding="{Binding OffRoadFriction}" Width="90"/>
        <DataGridTextColumn Binding="{Binding MudFriction}" Width="80"/>
        <DataGridCheckBoxColumn Binding="{Binding IgnoreIce}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
