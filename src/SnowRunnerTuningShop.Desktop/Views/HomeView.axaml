<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnowRunnerTuningShop.Desktop.Views.HomeView">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0">
      <Border x:Name="SetupPanel"
              Background="{DynamicResource AppCautionBrush}"
              BorderBrush="{DynamicResource AppCautionStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,0,16"
              IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="BaselineTitleText" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock x:Name="BaselineWarningText" TextWrapping="Wrap"/>
          <Button x:Name="SetBaselineButton"
                  HorizontalAlignment="Left"
                  Padding="14,8"
                  Click="SetBaselineButton_Click"/>
        </StackPanel>
      </Border>

      <Border x:Name="UpdateBanner"
              Background="{DynamicResource AppCardBrush}"
              BorderBrush="{DynamicResource AppAccentStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,0,16"
              IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="UpdateBannerTitle" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock x:Name="UpdateBannerMessage" TextWrapping="Wrap"/>
          <WrapPanel>
            <Button x:Name="DownloadUpdateButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="DownloadUpdateButton_Click"/>
            <Button x:Name="SkipUpdateButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="SkipUpdateButton_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="HealthBanner"
              Background="{DynamicResource AppCautionBrush}"
              BorderBrush="{DynamicResource AppCautionStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,0,16"
              IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="HealthBannerTitle" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock x:Name="HealthBannerMessage" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border x:Name="ReadyPanel"
              Background="{DynamicResource AppSuccessBrush}"
              BorderBrush="{DynamicResource AppSuccessStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,0,16"
              IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="BaselineReadyTitleText" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock x:Name="BaselineReadyTextBlock" TextWrapping="Wrap"/>
          <TextBlock x:Name="WorkingPakTextBlock" TextWrapping="Wrap" Opacity="0.8"/>
          <TextBlock x:Name="ProfileStatusTextBlock" TextWrapping="Wrap" Opacity="0.8"/>
          <WrapPanel>
            <Button x:Name="ChangeLocationButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="ChangeLocationButton_Click"/>
            <Button x:Name="RefreshBaselineButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="RefreshBaselineButton_Click"/>
            <Button x:Name="ReapplyButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="ReapplyButton_Click"/>
            <Button x:Name="RestoreFullBaselineButton"
                    Classes="danger"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="RestoreFullBaselineButton_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*">
      <Border Grid.Column="0"
              Background="{DynamicResource AppCardBrush}"
              BorderBrush="{DynamicResource AppCardStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,8,0">
        <DockPanel LastChildFill="True">
          <TextBlock x:Name="PresetsTitleText"
                     DockPanel.Dock="Top"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Margin="0,0,0,12"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="PresetNewButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="PresetNewButton_Click"/>
            <Button x:Name="PresetExportButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="PresetExportButton_Click"/>
            <Button x:Name="PresetImportButton"
                    Padding="14,8"
                    Margin="0,0,8,8"
                    Click="PresetImportButton_Click"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="PresetApplyButton"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Click="PresetApplyButton_Click"/>
            <Button x:Name="PresetSaveAsNewButton"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Click="PresetSaveAsNewButton_Click"/>
            <Button x:Name="PresetDeleteButton"
                    Padding="14,8"
                    Click="PresetDeleteButton_Click"/>
          </WrapPanel>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="130,55,90,40,*" Margin="0,0,0,8">
              <TextBlock x:Name="PresetNameColumnHeader" FontWeight="SemiBold"/>
              <TextBlock x:Name="PresetVersionColumnHeader" Grid.Column="1" FontWeight="SemiBold"/>
              <TextBlock x:Name="PresetAuthorColumnHeader" Grid.Column="2" FontWeight="SemiBold"/>
              <TextBlock x:Name="PresetLockColumnHeader" Grid.Column="3" FontWeight="SemiBold"/>
              <TextBlock x:Name="PresetStatusColumnHeader" Grid.Column="4" FontWeight="SemiBold"/>
            </Grid>
            <ListBox x:Name="PresetsList"
                     Background="Transparent"
                     BorderThickness="0"
                     PointerPressed="PresetsList_PointerPressed"
                     SelectionChanged="PresetsList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="130,55,90,40,*" Margin="0,0,0,6">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Version}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Author}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding LockGlyph}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Status}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource AppCardBrush}"
              BorderBrush="{DynamicResource AppCardStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="8,0,0,0">
        <Grid>
          <DockPanel x:Name="CategoriesPanel" LastChildFill="True">
            <TextBlock x:Name="CategoriesTitleText"
                       DockPanel.Dock="Top"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="140,70,70,*" Margin="0,0,0,8">
                <TextBlock x:Name="CategoryColumnHeader" FontWeight="SemiBold"/>
                <TextBlock x:Name="ItemsColumnHeader" Grid.Column="1" FontWeight="SemiBold"/>
                <TextBlock x:Name="FilesColumnHeader" Grid.Column="2" FontWeight="SemiBold"/>
                <TextBlock x:Name="SampleColumnHeader" Grid.Column="3" FontWeight="SemiBold"/>
              </Grid>
              <ScrollViewer>
                <ItemsControl x:Name="CategoriesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="140,70,70,*" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ItemCount}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FileCount}"/>
                        <TextBlock Grid.Column="3" Text="{Binding SampleFile}" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>

          <DockPanel x:Name="PresetDetailPanel"
                     LastChildFill="True"
                     IsVisible="False">
            <TextBlock x:Name="PresetDetailTitleText"
                       DockPanel.Dock="Top"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="PresetDetailNameText"
                       DockPanel.Dock="Top"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="PresetDetailAuthorText"
                       DockPanel.Dock="Top"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="PresetDetailVersionText"
                       DockPanel.Dock="Top"
                       Opacity="0.85"
                       Margin="0,0,0,12"/>
            <ScrollViewer>
              <TextBlock x:Name="PresetDetailDescriptionText"
                         TextWrapping="Wrap"
                         Opacity="0.85"
                         LineHeight="20"/>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
