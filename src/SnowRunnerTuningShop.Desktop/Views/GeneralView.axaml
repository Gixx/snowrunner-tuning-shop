<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnowRunnerTuningShop.Desktop.Views.GeneralView">
  <StackPanel Spacing="12">
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/>

    <Border Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
      <StackPanel Spacing="8">
        <TextBlock x:Name="CameraTitleText" FontWeight="SemiBold"/>
        <TextBlock x:Name="CameraHintText" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
        <Grid ColumnDefinitions="180,*" Margin="0,0,0,4">
          <TextBlock x:Name="CameraModeLabelText" VerticalAlignment="Center" Opacity="0.8"/>
          <ComboBox x:Name="CameraModeCombo"
                    Grid.Column="1"
                    MaxWidth="320"
                    MinWidth="220"
                    HorizontalAlignment="Left"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ApplyCameraButton"
                  Padding="14,8"
                  Click="ApplyCameraButton_Click"/>
          <Button x:Name="RestoreCameraButton"
                  Padding="14,8"
                  Click="RestoreCameraButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
      <StackPanel Spacing="8">
        <TextBlock x:Name="RockTitleText" FontWeight="SemiBold"/>
        <TextBlock x:Name="RockHintText" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
        <TextBlock x:Name="RockSizeLabel"/>
        <Slider x:Name="RockSizeSlider"
                Minimum="0"
                Maximum="4"
                Value="4"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                PropertyChanged="RockSizeSlider_PropertyChanged"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ApplyRockSizeButton"
                  Padding="14,8"
                  Click="ApplyRockSizeButton_Click"/>
          <Button x:Name="RestoreRockSizeButton"
                  Padding="14,8"
                  Click="RestoreRockSizeButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap"/>
    <TextBlock x:Name="HintText" Opacity="0.8" TextWrapping="Wrap" IsVisible="False"/>
  </StackPanel>
</UserControl>
