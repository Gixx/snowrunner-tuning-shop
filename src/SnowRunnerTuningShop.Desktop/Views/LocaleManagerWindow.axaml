<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SnowRunnerTuningShop.Desktop.Views.LocaleManagerWindow"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
  <DockPanel Margin="20">
    <TextBlock x:Name="TitleText"
               DockPanel.Dock="Top"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,8"/>
    <TextBlock x:Name="HintText"
               DockPanel.Dock="Top"
               TextWrapping="Wrap"
               FontSize="12"
               Opacity="0.8"
               Margin="0,0,0,10"/>
    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Top"
               TextWrapping="Wrap"
               FontSize="12"
               Opacity="0.8"
               Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button x:Name="RefreshButton" Padding="14,8" Click="RefreshButton_Click"/>
      <Button x:Name="ApplyButton" Padding="14,8" Click="ApplyButton_Click"/>
      <Button x:Name="CloseButton" Padding="14,8" Click="CloseButton_Click"/>
    </StackPanel>
    <Border x:Name="PackListHost"
            BorderBrush="{DynamicResource AppCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource AppCardBrush}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="12,8" ColumnDefinitions="92,72,*,180,88">
          <TextBlock x:Name="ColumnAddUpdate" FontWeight="SemiBold" Opacity="0.8"/>
          <TextBlock x:Name="ColumnRemove" Grid.Column="1" FontWeight="SemiBold" Opacity="0.8"/>
          <TextBlock x:Name="ColumnLanguage" Grid.Column="2" FontWeight="SemiBold" Opacity="0.8"/>
          <TextBlock x:Name="ColumnStatus" Grid.Column="3" FontWeight="SemiBold" Opacity="0.8"/>
          <TextBlock x:Name="ColumnRevision" Grid.Column="4" FontWeight="SemiBold" Opacity="0.8"/>
        </Grid>
        <ScrollViewer>
          <ItemsControl x:Name="PackList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="12,6" ColumnDefinitions="92,72,*,180,88">
                  <CheckBox VerticalAlignment="Center"
                            IsChecked="{Binding Wanted}"
                            IsEnabled="{Binding CanAddOrUpdate}"/>
                  <CheckBox Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding RemoveSelected}"
                            IsEnabled="{Binding CanRemove}"/>
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             Text="{Binding DisplayName}"
                             TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="3"
                             VerticalAlignment="Center"
                             Text="{Binding Status}"
                             TextWrapping="Wrap"
                             Opacity="0.8"/>
                  <TextBlock Grid.Column="4"
                             VerticalAlignment="Center"
                             Text="{Binding RevisionText}"
                             Opacity="0.8"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
