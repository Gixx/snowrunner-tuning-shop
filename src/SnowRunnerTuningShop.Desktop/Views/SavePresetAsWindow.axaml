<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SnowRunnerTuningShop.Desktop.Views.SavePresetAsWindow"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
    <TextBlock x:Name="NameLabel" Margin="0,0,0,6" Opacity="0.8"/>
    <TextBox x:Name="NameBox" Grid.Row="1" Padding="8" Margin="0,0,0,12"/>
    <TextBlock x:Name="VersionLabel" Grid.Row="2" Margin="0,0,0,6" Opacity="0.8"/>
    <TextBox x:Name="VersionBox" Grid.Row="3" Text="1.0.0" Padding="8" Margin="0,0,0,12"/>
    <TextBlock x:Name="AuthorLabel" Grid.Row="4" Margin="0,0,0,6" Opacity="0.8"/>
    <TextBox x:Name="AuthorBox" Grid.Row="5" Padding="8" Margin="0,0,0,12"/>
    <TextBlock x:Name="DescriptionLabel" Grid.Row="6" Margin="0,0,0,6" Opacity="0.8"/>
    <TextBox x:Name="DescriptionBox"
             Grid.Row="7"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="96"
             MaxHeight="180"
             Padding="8"
             Margin="0,0,0,12"/>
    <CheckBox x:Name="LockedCheckBox" Grid.Row="8" Margin="0,0,0,16"/>
    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Padding="14,8" Click="CancelButton_Click"/>
      <Button x:Name="SaveButton" Padding="14,8" Click="SaveButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
