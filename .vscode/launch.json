{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SnowRunner Tuning Shop (WPF)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-wpf",
      "program": "${workspaceFolder}/src/SnowRunnerTuningShop/bin/Debug/net10.0-windows/SnowRunnerTuningShop.dll",
      "cwd": "${workspaceFolder}/src/SnowRunnerTuningShop",
      "stopAtEntry": false
    },
    {
      "name": "SnowRunner Tuning Shop (Avalonia Desktop)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-desktop",
      "program": "${workspaceFolder}/src/SnowRunnerTuningShop.Desktop/bin/Debug/net10.0/SnowRunnerTuningShop.Desktop.dll",
      "cwd": "${workspaceFolder}/src/SnowRunnerTuningShop.Desktop",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
